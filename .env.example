# ==============================================================================
# AI Placement Analyzer - Environment Configuration Template
# ==============================================================================

# Project Details
PROJECT_NAME="AI Placement Analyzer"
VERSION="1.0.0"
ENVIRONMENT="development"
API_V1_STR="/api"

# ------------------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------------------
# For immediate local development (zero setup), SQLite is supported out of the box:
DATABASE_URL="sqlite:///./placement_analyzer.db"

# For Production or Supabase PostgreSQL with pgvector extension:
# DATABASE_URL="postgresql://postgres:your_password@localhost:5432/placement_analyzer"
# DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres"

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# ------------------------------------------------------------------------------
# Options: "mock" (built-in offline testing), "gemini", or "openai"
LLM_PROVIDER="mock"
LLM_MODEL="gemini-1.5-flash"

# Google Gemini API Key (Required if LLM_PROVIDER="gemini")
# GEMINI_API_KEY="your_gemini_api_key_here"

# OpenAI API Key (Required if LLM_PROVIDER="openai")
# OPENAI_API_KEY="your_openai_api_key_here"

# ------------------------------------------------------------------------------
# Vector Embeddings Configuration
# ------------------------------------------------------------------------------
# Options: "mock", "gemini", or "openai"
EMBEDDING_PROVIDER="mock"
EMBEDDING_MODEL="models/text-embedding-004"
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# Retrieval Hyperparameters
# ------------------------------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_SIMILARITY_THRESHOLD=0.35
RETRIEVAL_LEXICAL_WEIGHT=0.4
RETRIEVAL_VECTOR_WEIGHT=0.6

# ------------------------------------------------------------------------------
# Document Ingestion & Retention
# ------------------------------------------------------------------------------
UPLOAD_MAX_FILE_SIZE_BYTES=10485760  # 10MB
DOCUMENT_RETENTION_DAYS=30
